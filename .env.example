# Vyapaar Saathi Environment Configuration

# Anthropic Claude API (Primary AI Engine for Saathi AI Advisor)
# Obtain your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Server Port
PORT=5000

# Optional MongoDB Atlas connection string (defaults to local SQLite if empty)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vyapaar_saathi
