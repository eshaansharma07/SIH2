# ==============================================================================
# SAAKHSETU / VYAPAAR SETU - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port (default 3001)
PORT=3001

# AI Advisory Engines (Setu AI Advisor)
# Google Gemini API (Primary Engine via Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude API (Supported Secondary / Custom Key: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Twilio Verify v2 Credentials (required for real-time SMS OTP verification)
# Obtain these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# JWT Authentication Secret Key
# Used to sign and verify shopkeeper session tokens
JWT_SECRET=your_jwt_secret_key_minimum_32_chars

# MongoDB Atlas (Optional — falls back to local SQLite if unset)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/saakhsetu
