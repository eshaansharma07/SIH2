# SaakhSetu Environment Configuration

# Google Gemini API Key (Primary AI Engine for Setu AI Advisor)
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional Anthropic Claude API (Secondary Engine)
# ANTHROPIC_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Server Port
PORT=3001

# Optional MongoDB Atlas connection string (defaults to local SQLite if empty)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vyapaar_saathi
