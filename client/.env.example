# Firebase Web SDK Configuration for Real SMS OTP to Any Mobile Number (+91)
# You can get these from Firebase Console -> Project Settings -> General -> Your apps (Web)
# Alternatively, you can paste the snippet directly into the in-app "Configure SMS" dialog on the login screen!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
